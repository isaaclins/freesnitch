{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {
      "shouldTranslate" : false
    },
    "%@ (helper offline)" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (служба недоступна)"
          }
        }
      }
    },
    "%@ A disabled rule for this row exists; pressing this enables it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Для этой строки есть выключенное правило; нажатие включит его."
          }
        }
      }
    },
    "%@ Drag FreeSnitch into Applications in Finder, then open it from there." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Перетащите FreeSnitch в папку «Программы» в Finder и откройте его оттуда."
          }
        }
      }
    },
    "%@ FreeSnitch can copy itself there and reopen." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ FreeSnitch может скопировать себя туда и перезапуститься."
          }
        }
      }
    },
    "%@ FreeSnitch leaves it alone. Use the full path below, or remove that file yourself and come back here." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ FreeSnitch не трогает этот файл. Используйте полный путь ниже или удалите файл сами и вернитесь сюда."
          }
        }
      }
    },
    "%@ FreeSnitch will ask again next time it opens." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ FreeSnitch спросит снова при следующем запуске."
          }
        }
      }
    },
    "%@ No rule snapshot was delivered; filtering remains fail-open." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Снимок правил не получен, поэтому фильтр пропускает все соединения."
          }
        }
      }
    },
    "%@ Recording is off and runs in every mode." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Запись выключена; она работает в любом режиме."
          }
        }
      }
    },
    "%@ Recording is on and runs in every mode." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Запись включена и работает в любом режиме."
          }
        }
      }
    },
    "%@ The list fills in on its own once it connects." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Список заполнится сам после подключения."
          }
        }
      }
    },
    "%@ already exists and is not FreeSnitch's." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ уже существует и не принадлежит FreeSnitch."
          }
        }
      }
    },
    "%@ already exists." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ уже существует."
          }
        }
      }
    },
    "%@ already links to %@." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ уже ссылается на %@."
          }
        }
      }
    },
    "%@ and %@" : {
      "comment" : "The end of a list of profile names, as in Home, Work and Cafe",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ и %@"
          }
        }
      }
    },
    "%@ blocked" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заблокировано: %@"
          }
        }
      }
    },
    "%@ connections" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соединений: %@"
          }
        }
      }
    },
    "%@ is connected. Your rules still apply to every app's connections through the tunnel. If the VPN stops connecting while FreeSnitch is on, check that neither the VPN app nor its network extension is denied in Rules." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ подключён. Ваши правила по-прежнему действуют для соединений всех приложений через туннель. Если VPN перестаёт подключаться при включённом FreeSnitch, проверьте, что ни приложение VPN, ни его сетевое расширение не запрещены в разделе «Правила»."
          }
        }
      }
    },
    "%@ is handling DNS right now (%@), so FreeSnitch's DNS blocking and upstream don't apply while it is connected." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ сейчас обрабатывает DNS (%@), поэтому блокировка DNS и вышестоящий сервер FreeSnitch не действуют, пока он подключён."
          }
        }
      }
    },
    "%@ is the active profile, so this rule applies now." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ является активным профилем, поэтому это правило действует сейчас."
          }
        }
      }
    },
    "%@ macOS only installs background helpers for apps in Applications. Move FreeSnitch into /Applications, open it from there and try again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ macOS устанавливает фоновые службы только для приложений из папки «Программы». Переместите FreeSnitch в /Applications, откройте его оттуда и повторите попытку."
          }
        }
      }
    },
    "%@ may not reach %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не сможет подключаться к %@"
          }
        }
      }
    },
    "%@ of %@ blocked" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заблокировано %@ из %@"
          }
        }
      }
    },
    "%@ payload is oversized: %lld bytes (maximum %lld)." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: слишком большой объём данных, %lld байт (максимум %lld)."
          }
        }
      }
    },
    "%@ to %@" : {
      "comment" : "A rule named by its app and where it connects, as in Safari to apple.com\nApp and destination a rule decision covers, completes \"Remove the rule for …\"",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ → %2$@"

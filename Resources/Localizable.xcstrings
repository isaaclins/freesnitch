        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запущенная служба не поддерживает эталонные снимки правил. Выполните `%@` и повторите попытку."
          }
        }
      }
    },
    "The running helper is not the installed build" : {

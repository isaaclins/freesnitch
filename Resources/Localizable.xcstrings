    "Rules" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правила"
          }
        }
      }
    },
    "Rules FreeSnitch suggests from what it recorded, each for one app and one destination. Nothing changes until you accept a suggestion, one at a time." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правила, которые FreeSnitch предлагает на основе записанных данных, каждое для одного приложения и одного адреса назначения. Ничего не изменится, пока вы не примете предложение, по одному за раз."
          }
        }
      }
    },
    "Rules are created automatically when you allow or deny a connection alert." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правила создаются автоматически, когда вы разрешаете или запрещаете запрос на соединение."
          }
        }
      }
    },

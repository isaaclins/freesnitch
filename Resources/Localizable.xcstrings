          }
        }
      }
    },
    "Approve FreeSnitch in Login Items, and this fills in on its own." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одобрите FreeSnitch в разделе «Объекты входа и расширения», и данные появятся автоматически."

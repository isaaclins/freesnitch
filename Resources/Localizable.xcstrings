    },
    "Today FreeSnitch has asked about %lld new connections." : {
      "localizations" : {
        "ru" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Сегодня FreeSnitch запросил решение для %lld нового соединения."
                }
              },
              "few" : {

          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось подготовить удаление FreeSnitch."
          }
        }
      }
    },
    "The upstream URL has no host." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В URL сервера не указан хост."
          }
        }
      }
    },
    "The upstream URL is empty." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL сервера не указан."
          }
        }
      }
    },
    "The upstream URL must start with https://." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL сервера должен начинаться с https://."
          }
        }
      }
    },
    "The upstream URL starts or ends with a space." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL сервера начинается или заканчивается пробелом."
          }
        }
      }
    },
    "The upstream applies only while enforcement is on. Turn it on in General." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вышестоящий сервер используется, только когда применение правил включено. Включите его в разделе «Основные»."
          }
        }
      }
    },
    "The upstream is not a URL." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Указанное значение не является URL."
          }
        }
      }
    },
    "The upstream lives in the privileged helper, so it can be changed once the helper is connected." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вышестоящий сервер настраивается в привилегированной службе, поэтому его можно изменить после подключения службы."
          }
        }
      }
    },
    "There are %lld rules and at most %lld can be kept for the next start. Remove some rules to keep them across restarts." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Правил: %1$lld, а для следующего запуска можно сохранить не более %2$lld. Удалите часть правил, чтобы они сохранялись после перезапуска."
          }
        }
      }
    },
    "There are no rules to export." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет правил для экспорта."
          }
        }
      }
    },
    "There is no profile named %@ on this Mac. Its rules are imported but apply nowhere until you create a profile with that name." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом Mac нет профиля с именем %@. Его правила импортированы, но не будут действовать, пока вы не создадите профиль с таким именем."
          }
        }
      }
    },
    "There is no profile named %@ on this Mac. Their rules are imported but apply nowhere until you create a profile with that name." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом Mac нет профилей с именами %@. Их правила импортированы, но не будут действовать, пока вы не создадите профили с такими именами."
          }
        }
      }
    },
    "These %lld rules are not in the file and will be deleted." : {
      "localizations" : {
        "ru" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Это %lld правило отсутствует в файле и будет удалено."
                }
              },
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Эти %lld правила отсутствуют в файле и будут удалены."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Эти %lld правил отсутствуют в файле и будут удалены."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Эти %lld правил отсутствуют в файле и будут удалены."
                }
              }
            }
          }
        }
      }
    },
    "These %lld rules move to another profile." : {
      "localizations" : {
        "ru" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Это %lld правило переходит в другой профиль."
                }
              },
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Эти %lld правила переходят в другой профиль."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Эти %lld правил переходят в другой профиль."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Эти %lld правил переходят в другой профиль."
                }
              }
            }
          }
        }
      }
    },
    "These rules are dormant until %@ is the active profile." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти правила не действуют, пока активен не профиль %@."
          }
        }
      }
    },
    "These rules are in force now." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти правила сейчас действуют."
          }
        }
      }
    },
    "They are dated later than the Mac's clock, which happens when the clock is set back. This fixes itself the next time the rules are saved, for example with the next rule change." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Их дата позже, чем время на часах Mac. Так бывает, если часы перевели назад. Это исправится само при следующем сохранении правил, например при следующем изменении правила."
          }
        }
      }
    },
    "They are kept, so they come back if you install FreeSnitch again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Они сохраняются и вернутся, если вы снова установите FreeSnitch."
          }
        }
      }
    },
    "They can’t be recovered." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Их нельзя будет восстановить."
          }
        }
      }
    },
    "They could not be saved for the next start: %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить их для следующего запуска: %@"
          }
        }
      }
    },
    "This Mac sends its lookups to %@ directly. FreeSnitch does not change your network settings. To send them through FreeSnitch, set the DNS server to 127.0.0.1 in System Settings > Network > your network > Details > DNS. A DNS profile, VPN or DNS app takes priority over that. Set it back before you turn enforcement off or remove FreeSnitch, or this Mac cannot look up names." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот Mac отправляет DNS-запросы напрямую на %@. FreeSnitch не меняет ваши сетевые настройки. Чтобы запросы шли через FreeSnitch, укажите DNS-сервер 127.0.0.1 в меню «Системные настройки» > «Сеть» > ваша сеть > «Подробнее» > «DNS». DNS-профиль, VPN или DNS-приложение имеют приоритет над этой настройкой. Верните прежнее значение, прежде чем выключить фильтрацию или удалить FreeSnitch, иначе этот Mac не сможет разрешать имена."
          }
        }
      }
    },
    "This Mac's DNS server is FreeSnitch, which filters lookups and forwards the rest over HTTPS. %@" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DNS-сервер этого Mac — FreeSnitch: он фильтрует DNS-запросы, а остальные пересылает по HTTPS. %@"
          }
        }
      }
    },
    "This Mac's DNS server is set to this Mac, but the FreeSnitch DNS proxy is not running. Unless another DNS app answers there, names cannot be looked up. Turn enforcement on, or set the DNS server back in System Settings > Network." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В качестве DNS-сервера указан сам этот Mac, но DNS-прокси FreeSnitch не запущен. Если там не отвечает другое DNS-приложение, имена не разрешаются. Включите фильтрацию или верните прежний DNS-сервер в меню «Системные настройки» > «Сеть»."
          }
        }
      }
    },
    "This address and port" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот адрес и порт"
          }
        }
      }
    },
    "This app copy does not contain both the helper declaration and executable, so registration cannot be attempted." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этой копии приложения нет описания службы или её исполняемого файла, поэтому регистрация невозможна."
          }
        }
      }
    },
    "This app copy does not contain both the helper declaration and executable, so registration cannot be attempted. Install the signed FreeSnitch release again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этой копии приложения нет описания службы или её исполняемого файла, поэтому регистрация невозможна. Установите подписанный выпуск FreeSnitch заново."
          }
        }
      }
    },
    "This blocklist contains %lld domain entries." : {
      "localizations" : {
        "ru" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Этот список блокировки содержит %lld домен."
                }
              },
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Этот список блокировки содержит %lld домена."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Этот список блокировки содержит %lld доменов."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Этот список блокировки содержит %lld доменов."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This blocklist contains %lld domain entry."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This blocklist contains %lld domain entries."
                }
              }
            }
          }
        }
      }
    },
    "This copy of FreeSnitch does not include a supported Network Extension. Traffic monitoring can continue, but the firewall is not filtering connections." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта копия FreeSnitch не содержит поддерживаемого сетевого расширения. Мониторинг трафика может продолжаться, но брандмауэр не фильтрует соединения."
          }
        }
      }
    },
    "This copy of FreeSnitch isn't signed the way macOS requires for a helper. Download the signed release again and replace this copy." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта копия FreeSnitch подписана не так, как macOS требует для службы. Загрузите подписанный выпуск заново и замените эту копию."
          }
        }
      }
    },
    "This host" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот хост"
          }
        }
      }
    },
    "This is as far as one screen goes. Choose a shorter range to see the rest." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Больше на одном экране не помещается. Выберите более короткий период, чтобы увидеть остальное."
          }
        }
      }
    },
    "This permanently removes %lld rules from FreeSnitch." : {
      "localizations" : {
        "ru" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld правило будет безвозвратно удалено из FreeSnitch."
                }
              },
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld правила будут безвозвратно удалены из FreeSnitch."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld правил будут безвозвратно удалены из FreeSnitch."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld правил будут безвозвратно удалены из FreeSnitch."
                }
              }
            }
          }
        }
      }
    },
    "This removes every recorded connection, every DNS answer and every daily rollup, including the database write-ahead log. It cannot be undone." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будут удалены все записанные соединения, все ответы DNS и все дневные сводки, включая журнал предзаписи базы данных. Это действие нельзя отменить."
          }
        }
      }
    },
    "This row has no destination a rule can name, so nothing was changed." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У этой строки нет адреса назначения, который можно указать в правиле, поэтому ничего не изменено."
          }
        }
      }
    },
    "This row has no destination a rule can name." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У этой строки нет адреса назначения, который можно указать в правиле."
          }
        }
      }
    },
    "This rule is not in the file and will be deleted." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это правило отсутствует в файле и будет удалено."
          }
        }
      }
    },
    "This rule moves to another profile." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это правило переходит в другой профиль."
          }
        }
      }
    },
    "This rule names the app only by its name, so it applies to every app. Turn it off, or remove it and add it again for the app." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этом правиле приложение указано только по имени, поэтому оно действует для всех приложений. Выключите его или удалите и добавьте заново для нужного приложения."
          }
        }
      }
    },
    "This signed app still contains the helper declaration and executable, but SMAppService lost or cannot find its registration record. Background App Activity may still show FreeSnitch as on while launchd has no service. Register it again; toggling that switch alone is not sufficient." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это подписанное приложение по-прежнему содержит описание службы и её исполняемый файл, но SMAppService потерял или не может найти запись о её регистрации. В разделе «Фоновая активность приложений» FreeSnitch может отображаться включённым, хотя в launchd службы нет. Зарегистрируйте её заново: одного переключения этого параметра недостаточно."
          }
        }
      }
    },
    "This turns off FreeSnitch and removes everything it installed: its network filter, its background helper and its firewall rules. Then FreeSnitch moves itself to the Trash and quits." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FreeSnitch будет выключен, и всё, что он установил, будет удалено: сетевой фильтр, фоновая служба и правила брандмауэра. Затем FreeSnitch переместит себя в Корзину и завершит работу."
          }
        }
      }
    },
    "Throughput" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пропускная способность"
          }
        }
      }
    },
    "Title" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заголовок"
          }
        }
      }
    },
    "To use FreeSnitch's DNS while it is connected, turn off Use Tailscale DNS Settings in the Tailscale menu, then set this Mac's DNS server to 127.0.0.1 if it isn't already." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы использовать DNS FreeSnitch, пока Tailscale подключён, выключите Use Tailscale DNS Settings в меню Tailscale, а затем укажите для этого Mac DNS-сервер 127.0.0.1, если он ещё не указан."
          }
        }
      }
    },
    "To use FreeSnitch's DNS while it is connected, turn off the VPN's own DNS in its settings, if it has that option, then set this Mac's DNS server to 127.0.0.1 if it isn't already." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы использовать DNS FreeSnitch, пока VPN подключена, выключите собственный DNS VPN в её настройках, если такой параметр есть, а затем укажите для этого Mac DNS-сервер 127.0.0.1, если он ещё не указан."
          }
        }
      }
    },
    "Today FreeSnitch has asked about %lld new connections and silently allowed %lld it already knew." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сегодня FreeSnitch запросил решение для %#@asked@ и тихо разрешил %#@allowed@."
          },
          "substitutions" : {
            "asked" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg нового соединения"
                    }
                  },
                  "few" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg новых соединений"
                    }
                  },
                  "many" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg новых соединений"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg нового соединения"
                    }
                  }
                }
              }
            },
            "allowed" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg уже известное"
                    }
                  },
                  "few" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg уже известных"
                    }
                  },
                  "many" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg уже известных"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg уже известного"
                    }
                  }
                }
              }
            }
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Today FreeSnitch has asked about %#@asked@ and silently allowed %#@allowed@ it already knew."
          },
          "substitutions" : {
            "asked" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {

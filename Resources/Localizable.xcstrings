    },
    "SMAppService did not leave a usable registration record. Do not run the kickstart command yet; run the helper recheck again and report the registration state." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMAppService не оставил пригодной записи о регистрации. Пока не выполняйте команду kickstart: снова запустите повторную проверку службы и сообщите состояние регистрации."
          }
        }
      }
    },
    "SMAppService registered the helper, but it did not reconnect. Registration exists, so run `%@` in Terminal." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SMAppService зарегистрировал службу, но она не подключилась снова. Регистрация есть, поэтому выполните `%@` в Терминале."
          }
        }
      }
    },
    "SMAppService registration did not produce a reachable helper. Recheck the registration state before using the kickstart command." : {
